# Solana RPC Configuration
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Commitment level (processed, confirmed, finalized)
COMMITMENT=confirmed

# Token Monitor Configuration
# How often to check for newly launched tokens (in milliseconds)
POLL_INTERVAL_MS=10000

# DexScreener Public Market Data API Endpoint
DEXSCREENER_API_URL=https://api.dexscreener.com

# Risk & Safety Filter Thresholds
MIN_LIQUIDITY_USD=1000
MIN_5M_VOLUME_USD=500
MIN_5M_BUYS=5
MIN_5M_SELLS=2
MAX_TOKEN_AGE_MINUTES=180

# Phase 4 Trading Strategy Configuration
STRATEGY_MIN_SCORE=50

# Phase 5 Paper Trading Configuration
PAPER_TRADE_AMOUNT_USD=10
PROFIT_TARGET_PERCENT=5
STOP_LOSS_PERCENT=3
MAX_HOLD_TIME_MS=300000

# Phase 9 Live Trading Safety Architecture Configuration
# PAPER = Paper Trading Mode (Default), LIVE = Fail-Closed Disabled Mode
TRADING_MODE=PAPER
MAX_SLIPPAGE_PERCENT=1.0
EMERGENCY_KILL_SWITCH=false






