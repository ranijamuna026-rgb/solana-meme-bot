# ============================================================================
# SOLANA MEMECOIN BOT — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# MODE: REAL SOLANA MAINNET MARKET DATA + PAPER TRADING ONLY
# ============================================================================

# 1. Solana Mainnet RPC Configuration (Read-Only Public Data)
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
COMMITMENT=confirmed

# 2. Token Monitoring Polling Rate (in milliseconds)
POLL_INTERVAL_MS=10000

# 3. DexScreener Public Market Data API URL
DEXSCREENER_API_URL=https://api.dexscreener.com

# 4. Phase 8 Advanced Risk Manager Thresholds
MIN_LIQUIDITY_USD=10000
MIN_5M_VOLUME_USD=5000
MIN_5M_BUYS=5
MIN_5M_SELLS=2
MAX_TOKEN_AGE_MINUTES=180
MIN_STRATEGY_SCORE=70
MAX_RISK_SCORE=60

# 5. Position & Risk Management Limits
MAX_TRADES_PER_HOUR=10
MAX_TRADES_PER_DAY=30
MAX_DAILY_LOSS_USD=20
COOLDOWN_AFTER_LOSS_MINUTES=5
MAX_CONSECUTIVE_LOSSES=3
RISK_PER_TRADE_PERCENT=1
MIN_POSITION_SIZE_USD=5
MAX_POSITION_SIZE_USD=10
MAX_POSITION_LIQUIDITY_PERCENT=1

# 6. Paper Trading Engine Configuration (Simulated Execution Only)
PAPER_TRADE_AMOUNT_USD=10
PROFIT_TARGET_PERCENT=5
STOP_LOSS_PERCENT=3
MAX_HOLD_MINUTES=5
PRICE_POLL_INTERVAL_MS=5000

# 7. Dashboard HTTP Server Port (Read-Only REST API)
PORT=3000

# 8. Execution Safety Architecture (PAPER = Paper Trading Only)
TRADING_MODE=PAPER
MAX_SLIPPAGE_PERCENT=1.0
EMERGENCY_KILL_SWITCH=false

# 9. Pre-Launch Discovery & Launch-Day Automated Scheduler Configuration
PRELAUNCH_TIMEZONE=UTC
PRELAUNCH_DISCOVERY_INTERVAL_MINUTES=30
LAUNCH_ANNOUNCEMENT_DISCOVERY_ENABLED=true
LAUNCH_ANNOUNCEMENT_DISCOVERY_INTERVAL_MINUTES=30
LAUNCH_DAY_SCHEDULER_ENABLED=true
LAUNCH_DAY_POLL_INTERVAL_MS=60000
